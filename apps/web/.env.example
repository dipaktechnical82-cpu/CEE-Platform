# Nepal CEE Frontend Environment Configuration (Baseline Template)
# Copy to .env.local for local development. NEVER commit real secrets or production keys.

# Public Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Environment ('development' | 'staging' | 'production')
NEXT_PUBLIC_ENVIRONMENT=development

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_TUTOR_PREVIEW=false
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

# Analytics / Telemetry (Optional, Leave empty in local dev)
NEXT_PUBLIC_ANALYTICS_ID=
