# Nepal CEE Backend Environment Configuration (Template)
# Copy to apps/api/.env for local development. NEVER commit real credentials.

# Django Core
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=insecure-development-key-change-in-production-only-cee-nepal-32-chars
JWT_SIGNING_KEY=insecure-development-jwt-signing-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cee_platform_dev

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_REQUIRED=True

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Authentication cookie settings
# Leave the domain empty for local development; production must use its shared parent domain.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=Lax
AUTH_ACCESS_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth/
CSRF_COOKIE_PATH=/
DEV_USE_LOCMEM_CACHE=False

# Authentication email (development settings use the console backend)
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CEE Medical Prep <no-reply@example.com>

# Object Storage (S3 / MinIO - for Phase 4+)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=cee-platform-assets-dev
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=

# AI Tutor Provider (Provider-agnostic interface, Phase 6)
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
